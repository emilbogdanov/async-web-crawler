CRAWLER_USER_AGENT="AsyncWebCrawler/0.1 (+https://github.com/ESBogdanov25/async-web-crawler)"
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES=100
CRAWLER_CONCURRENCY=10
CRAWLER_PER_DOMAIN_DELAY=1.0
CRAWLER_REQUEST_TIMEOUT=10.0
CRAWLER_MAX_RETRIES=3
CRAWLER_BACKOFF_BASE=0.5
CRAWLER_MAX_RESPONSE_BYTES=5242880
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_SAME_HOST_ONLY=true
